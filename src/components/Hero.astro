---
import { profile } from '../data/portfolio';

---

<section class="hero" aria-labelledby="hero-name">
	<!-- One heading for name and role, so the page's main heading says who and what -->
	<h1 id="hero-name">
		<!-- The name rises out of its mask on load -->
		<span class="w"><span class="name">{profile.name}</span></span>
		<span class="role" data-hero="line">{profile.role} based in {profile.city}</span>
	</h1>

	<div class="info" data-hero="info">
		<p class="lede">{profile.intro}</p>
		<div class="actions">
			<a class="primary" href="#projects">See projects</a>
			<a href={profile.github}>GitHub</a>
			<a href={profile.linkedin}>LinkedIn</a>
		</div>
	</div>
</section>

<style>
	/* The hero fills the first screen, its content centred in it */
	.hero {
		min-height: calc(100svh - 3rem);
		display: grid;
		align-content: center;
		gap: clamp(1.75rem, 4vw, 2.75rem);
		padding-block: 6rem clamp(1.5rem, 4vw, 2.5rem);
	}

	h1 {
		text-wrap: balance;
		font-weight: 400;
	}

	.name {
		font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.w {
		display: block;
		overflow: clip;
		padding-bottom: 0.08em;
	}

	.w > span {
		display: block;
	}

	.role {
		display: block;
		margin-top: clamp(1rem, 2.5vw, 1.5rem);
		font-size: var(--step-1);
		color: var(--slate);
	}

	.info {
		display: grid;
		gap: 1.5rem 3rem;
		padding-top: 1.25rem;
		border-top: 2px solid var(--ink);
	}

	@media (min-width: 52rem) {
		.info {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: end;
		}
	}

	.lede {
		max-width: 34ch;
		font-size: var(--step-2);
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		font-weight: 800;
	}

	.actions .primary {
		display: inline-flex;
		align-items: center;
		min-height: 3rem;
		padding-inline: 1.25rem;
		border: 2px solid var(--ink);
		border-radius: var(--radius-control);
		background: var(--ink);
		color: var(--paper);
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.actions .primary:hover {
		background: transparent;
		color: var(--ink);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		.actions a {
			transition: none;
		}
	}

	.actions a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.actions a:active {
		opacity: 0.7;
	}
</style>
