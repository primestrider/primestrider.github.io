---
import { profile, projects } from '../data/portfolio';

// "Work, mobile app" → group "Work", type "mobile app"; groups keep their first-seen order
const groups: { name: string; items: { p: (typeof projects)[number]; type: string }[] }[] = [];
for (const p of projects) {
	const [name, ...rest] = p.kind.split(',');
	let group = groups.find((g) => g.name === name);
	if (!group) groups.push((group = { name, items: [] }));
	group.items.push({ p, type: rest.join(',').trim() });
}

const num = (n: number) => String(n + 1).padStart(2, '0');
---

<!--
	Projects as an accordion: numbered rows between hairlines, the name large, one row open at a time
	with its summary, stack and links. Without JS every row is listed open.
-->
<section class="projects" id="projects" aria-labelledby="projects-h" data-projects>
	<div class="head">
		<h2 id="projects-h" class="heading" data-reveal="heading">Projects</h2>

		<!-- A plain text filter, one group at a time; the script reveals it -->
		<div class="tabs" role="tablist" aria-label="Project type" data-reveal hidden>
			{
				groups.map((g, i) => (
					<button
						type="button"
						role="tab"
						id={`project-tab-${i}`}
						aria-controls={`project-group-${i}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
					>
						{g.name}
						<sup class="count">{g.items.length}</sup>
					</button>
				))
			}
		</div>
	</div>

	<div class="groups">
		{
			groups.map((g, i) => (
				<div class="group" id={`project-group-${i}`}>
					<h3 class="group-h">{g.name}</h3>
					{/* Only the first group reveals on scroll; the others animate when their tab opens */}
					<ol role="list" class="rows" data-reveal={i === 0 ? 'stagger' : undefined}>
						{g.items.map(({ p, type }, j) => (
							<li class:list={['row', j === 0 && 'is-open']}>
								<h4 class="row-h">
									<button
										type="button"
										class="row-btn"
										id={`row-${i}-${j}`}
										aria-expanded="true"
										aria-controls={`row-body-${i}-${j}`}
										disabled
									>
										<span class="num">{num(j)}</span>
										<span class="title">{p.title}</span>
										<span class="type">{type}</span>
										<span class="sign" aria-hidden="true" />
									</button>
								</h4>
								<div class="body" id={`row-body-${i}-${j}`} role="region" aria-labelledby={`row-${i}-${j}`}>
									<p class="summary">{p.summary}</p>
									{p.stack && (
										<ul class="stack" aria-label="Built with">
											{p.stack.map((t) => (
												<li>{t}</li>
											))}
										</ul>
									)}
									{p.links && p.links.length > 0 && (
										<p class="links">
											{p.links.map((l) => (
												<a href={l.href} aria-label={`${l.label}: ${p.title}`}>
													{l.label}
												</a>
											))}
										</p>
									)}
								</div>
							</li>
						))}
					</ol>
				</div>
			))
		}
	</div>

	<p class="more" data-reveal><a href={profile.github}>See all repositories on GitHub</a></p>
</section>

<style>
	.projects {
		padding-block: clamp(6rem, 12vw, 10rem) clamp(5rem, 10vw, 8rem);
	}

	ul,
	ol {
		list-style: none;
		padding: 0;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: 1.5rem 3rem;
		margin-bottom: clamp(2rem, 4vw, 3.5rem);
	}

	/* Filter: group names as text, the chosen one in ink over a thick rule */
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.75rem;
	}

	.tabs[hidden] {
		display: none;
	}

	[role='tab'] {
		position: relative;
		min-height: 2.75rem;
		padding: 0;
		border: 0;
		background: transparent;
		font: inherit;
		font-weight: 800;
		color: var(--slate);
		white-space: nowrap;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	[role='tab']::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		bottom: 0.35rem;
		height: 3px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}

	[role='tab']:hover,
	[role='tab'][aria-selected='true'] {
		color: var(--ink);
	}

	[role='tab'][aria-selected='true']::after {
		transform: scaleX(1);
	}

	.count {
		margin-left: 0.15em;
		font-size: 0.7em;
		font-weight: 400;
		font-variant-numeric: tabular-nums;
	}

	/* Without JS every group shows under its own heading */
	.group + .group {
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}

	.group[hidden] {
		display: none;
	}

	.group-h {
		margin-bottom: 1rem;
		font-size: var(--step-0);
		font-weight: 400;
		color: var(--slate);
	}

	/* With the filter, it names the group, so the heading is kept for screen readers only */
	.is-tabbed .group-h {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.is-tabbed .group + .group {
		margin-top: 0;
	}

	/* Rows between hairlines */
	.rows {
		border-bottom: 1px solid var(--line);
	}

	.row {
		border-top: 1px solid var(--line);
	}

	.row-h {
		font: inherit;
	}

	/* The row's button: number, name, type, and a plus that turns to a cross when open */
	.row-btn {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) auto;
		align-items: baseline;
		gap: 0.25rem 1rem;
		width: 100%;
		padding: clamp(1.1rem, 2vw, 1.5rem) 0;
		border: 0;
		background: transparent;
		font: inherit;
		color: var(--ink);
		text-align: start;
	}

	/* Without JS the buttons do nothing, so they read as plain headings */
	.row-btn:disabled {
		opacity: 1;
		cursor: default;
	}

	.is-accordion .row-btn {
		cursor: pointer;
	}

	.num {
		font-size: var(--step--1);
		font-variant-numeric: tabular-nums;
		color: var(--slate);
	}

	.title {
		font-size: clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
		overflow-wrap: break-word;
		min-width: 0;
		transition: transform 0.3s ease;
	}

	.type {
		grid-column: 2;
		font-size: var(--step--1);
		color: var(--slate);
	}

	.sign {
		display: none;
	}

	/* Wide screens: the type moves to the right of the name, before the sign */
	@media (min-width: 48rem) {
		.row-btn {
			grid-template-columns: 3rem minmax(0, 1fr) auto auto;
			gap: 1.5rem;
		}

		.type {
			grid-column: auto;
		}
	}

	.is-accordion .sign {
		display: block;
		grid-column: -2;
		grid-row: 1;
		position: relative;
		width: 0.875rem;
		height: 0.875rem;
		align-self: center;
		transition: transform 0.3s ease;
	}

	.is-accordion .sign::before,
	.is-accordion .sign::after {
		content: '';
		position: absolute;
		inset: 50% 0 auto;
		height: 2px;
		margin-top: -1px;
		background: var(--ink);
	}

	.is-accordion .sign::after {
		transform: rotate(90deg);
	}

	.is-accordion .is-open .sign {
		transform: rotate(45deg);
	}

	/* Hover: closed names nudge right a step, the way a cursor moves along a list */
	.is-accordion .row:not(.is-open) .row-btn:hover .title {
		transform: translateX(0.5rem);
	}

	/* The open row's details, indented under the name */
	.body {
		display: grid;
		gap: 0.75rem 2.5rem;
		padding: 0 0 clamp(1.5rem, 3vw, 2.25rem) 3.5rem;
	}

	.body[hidden] {
		display: none;
	}

	@media (min-width: 48rem) {
		.body {
			grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
			align-items: start;
			padding-left: 4.5rem;
		}
	}

	.summary {
		max-width: 46ch;
	}

	/* The stack as a slash-separated line, the way a developer would write it */
	.stack {
		display: flex;
		flex-wrap: wrap;
		font-size: var(--step--1);
		color: var(--slate);
	}

	.stack li + li::before {
		content: '/';
		padding-inline: 0.5em;
		opacity: 0.5;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		font-weight: 800;
	}

	.more {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		font-weight: 800;
	}
</style>

<script>
	import { gsap } from 'gsap';

	const root = document.querySelector<HTMLElement>('[data-projects]');
	const tablist = root?.querySelector<HTMLElement>('[role="tablist"]');
	const tabs = root ? [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')] : [];
	const groups = root ? [...root.querySelectorAll<HTMLElement>('.group')] : [];
	const still = matchMedia('(prefers-reduced-motion: reduce)');

	function setOpen(row: HTMLElement, open: boolean) {
		row.classList.toggle('is-open', open);
		row.querySelector('.row-btn')!.setAttribute('aria-expanded', String(open));
		row.querySelector<HTMLElement>('.body')!.hidden = !open;
	}

	// Open one row and close the others in its list; clicking the open row closes it.
	// The height snaps; only the details fade in.
	function toggleRow(row: HTMLElement) {
		const opening = !row.classList.contains('is-open');
		for (const r of row.parentElement!.children as HTMLCollectionOf<HTMLElement>) setOpen(r, opening && r === row);
		if (opening && !still.matches) {
			gsap.fromTo(
				row.querySelectorAll('.body > *'),
				{ autoAlpha: 0, y: 8 },
				{ autoAlpha: 1, y: 0, duration: 0.45, ease: 'power3.out', stagger: 0.05 },
			);
		}
	}

	function selectGroup(i: number, focus = false) {
		tabs.forEach((t, j) => {
			t.setAttribute('aria-selected', String(j === i));
			t.tabIndex = j === i ? 0 : -1;
		});
		groups.forEach((g, j) => (g.hidden = j !== i));
		if (focus) tabs[i].focus();
		if (!still.matches) {
			gsap.fromTo(
				groups[i].querySelectorAll('.row'),
				{ autoAlpha: 0, y: 16 },
				{ autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.04 },
			);
		}
	}

	if (root) {
		// Accordion: the first row of each list open, the others closed
		root.classList.add('is-accordion');
		root.querySelectorAll<HTMLElement>('.row').forEach((row) => {
			const btn = row.querySelector<HTMLButtonElement>('.row-btn')!;
			btn.disabled = false;
			setOpen(row, row.classList.contains('is-open'));
			btn.addEventListener('click', () => toggleRow(row));
		});
	}

	if (root && tablist && tabs.length) {
		root.classList.add('is-tabbed');
		tablist.hidden = false;
		groups.forEach((g, i) => {
			g.setAttribute('role', 'tabpanel');
			g.setAttribute('aria-labelledby', tabs[i].id);
			if (i !== 0) g.hidden = true;
		});

		tabs.forEach((t, i) => {
			t.addEventListener('click', () => selectGroup(i));
			// Arrow keys, Home and End move between tabs
			t.addEventListener('keydown', (e) => {
				const last = tabs.length - 1;
				const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
				if (next === undefined) return;
				e.preventDefault();
				selectGroup(next, true);
			});
		});
	}
</script>
