---
// Self-hosted variable font: no request to Google, and the Latin file is preloaded below
import '@fontsource-variable/jetbrains-mono';
import fontLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
}

const { title, description, image = '/og.jpg', noindex = false } = Astro.props;

// Absolute URLs need `site` in astro.config.mjs; without it the URL-based tags are left out
const site = Astro.site;
const canonical = site && new URL(Astro.url.pathname, site).href;
const imageUrl = site ? new URL(image, site).href : image;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Google Search Console ownership; keep it, Google re-checks periodically -->
		<meta name="google-site-verification" content="R74LGqAfR2h_lMaQU2JE1gm6bjGod6Bi0GfS0KbmTCM" />
		{noindex && <meta name="robots" content="noindex" />}
		<!-- Matches --paper in each scheme -->
		<meta name="theme-color" content="#f8f8f5" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b0b09" media="(prefers-color-scheme: dark)" />
		<link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<link rel="apple-touch-icon" href="/favicon.webp" />
		{canonical && <link rel="canonical" href={canonical} />}

		<!-- Link previews (WhatsApp, LinkedIn, X, Slack) -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="en_US" />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<slot name="head" />
		<!-- Hide reveal targets only when JS runs, so content never stays hidden without it -->
		<script is:inline>
			document.documentElement.classList.add('js');
			// If the reveal script never runs, show everything rather than leave it hidden
			setTimeout(() => window.__revealReady || document.documentElement.classList.remove('js'), 3000);
		</script>
	</head>
	<body>
		<slot />
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>

<style is:global>
	/* Hallmark · redesign: full · genre: editorial (inferred) · theme: brand (black and white, JetBrains Mono, the PS mark) · hero: Settled · nav: fixed bar, the PS mark left and four section links right · footer: inverted contact band over a base line of links · signature: the intro set large under the handle, over one rule · job: hire · v2.0.0 */
	/* Hallmark · pre-emit critique: P4 H4 E4 S4 R4 V4 · weakest: R, cards everywhere risk a template; the bento varies sizes by content (the statement two thirds, Frontend 2 by 2) and only one card per block is inverted */
	/* Hallmark · waive 64 · body and display are both JetBrains Mono · mono is the brand face of this developer portfolio, set everywhere on purpose */
	/* Hallmark · waive 26b · no form controls, no aria-disabled · links and the project tab buttons take hover, active and focus here; nothing on this portfolio is ever disabled */
	/* Hallmark · waive 39b · a.cta is the footer headline set as a text link, not a button · the LinkedIn link is the contact section itself */
	/* Hallmark · waive 79 · hero content centred in a Settled screen · the owner asked for the primestrider name small, so the hero keeps air instead of a giant handle */
	/* Hallmark · reworded the h1 "primestrider Software developer based in Jakarta, Indonesia" to the same words set as name over role · 58 named the three text blocks before the hero actions; the status line moved to the contact band */
	/* Hallmark · dismissed kept 13:40 · the live Jakarta clock moved to the contact band and reads a new minute on every load */
	/* Hallmark · dismissed 49 · the project tabs set white-space: nowrap on [role=tab] */
	/* Hallmark · dropped [data-work], [data-panel] · the sticky detail panel became a card grid, then, at the owner's ask, a numbered accordion of hairline rows, one project open at a time; the About experience cards became hairline rows too */

	:root {
		/* Near-black and near-white: still black and white, without the pure absolutes */
		--paper: oklch(98% 0.004 95);
		--ink: oklch(17% 0.005 95);
		--slate: oklch(46% 0.005 95);
		--line: oklch(87% 0.005 95);
		--surface: oklch(95% 0.004 95);
		--accent: var(--ink);

		/* The inverted band (skills and contact) */
		--band-paper: oklch(17% 0.005 95);
		--band-ink: oklch(97% 0.004 95);
		--band-slate: oklch(74% 0.005 95);
		--band-line: oklch(32% 0.005 95);
		--band-surface: oklch(21% 0.005 95);


		--radius-card: 1rem;
		--radius-control: 0.5rem;

		/* One mono family carries display and body alike */
		--font-body: 'JetBrains Mono Variable', ui-monospace, 'Cascadia Code', Consolas, monospace;
		--font-display: var(--font-body);

		--step--1: 0.875rem;
		--step-0: 1rem;
		--step-1: 1.1875rem;
		--step-2: clamp(1.375rem, 1.1rem + 1.1vw, 2rem);
		--step-section: clamp(2.5rem, 1.6rem + 3vw, 4rem);

		--gutter: clamp(1rem, 4vw, 3rem);
		--max: 72rem;
		color-scheme: light;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--paper: oklch(13% 0.004 95);
			--ink: oklch(96% 0.004 95);
			--slate: oklch(70% 0.005 95);
			--line: oklch(27% 0.005 95);
			--surface: oklch(18% 0.005 95);

			/* In dark mode the band lifts a step instead of inverting */
			--band-paper: oklch(18% 0.005 95);
			--band-ink: oklch(96% 0.004 95);
			--band-slate: oklch(72% 0.005 95);
			--band-line: oklch(31% 0.005 95);
			--band-surface: oklch(22.5% 0.005 95);

			color-scheme: dark;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		overflow-x: clip;
		scroll-behavior: smooth;
		scroll-padding-top: 4.5rem;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	body {
		margin: 0;
		overflow-x: clip;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--font-body);
		font-size: var(--step-0);
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3,
	h4,
	p,
	ul,
	ol,
	dl,
	dd {
		margin: 0;
	}

	h1,
	h2,
	h3 {
		text-wrap: balance;
		overflow-wrap: break-word;
		min-width: 0;
	}

	a {
		color: inherit;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.25em;
		transition: text-underline-offset 0.2s ease;
	}

	a:hover {
		text-underline-offset: 0.4em;
	}

	a:active,
	button:active {
		opacity: 0.7;
	}

	button:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	/* Hover motion stays, but instant, for people who turn motion off */
	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			transition-duration: 0.01ms !important;
		}
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* Section names: one size and one weight on every section */
	.heading {
		font-family: var(--font-display);
		font-size: var(--step-section);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	/* Cards: one surface step above the paper, a hairline edge, one radius */
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
		padding: clamp(1.25rem, 2.5vw, 2rem);
		background: var(--surface);
		color: var(--ink);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
	}

	/* Motion targets stay hidden until src/scripts/motion.ts reveals them */
	.js [data-hero],
	.js [data-reveal],
	.js .hero .w > span {
		visibility: hidden;
	}

	::selection {
		background: var(--ink);
		color: var(--paper);
	}
</style>
