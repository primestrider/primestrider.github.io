---
import { profile, projects } from '../data/portfolio';

// "Work, mobile app" → group "Work", type "mobile app"; groups keep their first-seen order
const groups: { name: string; items: { p: (typeof projects)[number]; type: string }[] }[] = [];
for (const p of projects) {
	const [name, ...rest] = p.kind.split(',');
	let group = groups.find((g) => g.name === name);
	if (!group) groups.push((group = { name, items: [] }));
	group.items.push({ p, type: rest.join(',').trim() });
}
---

<section class="projects" id="projects" aria-labelledby="projects-h" data-projects>
	<div class="head">
		<h2 id="projects-h" class="heading" data-reveal="heading">Projects</h2>

		<!-- Tabs show one group at a time; the script reveals them. Without JS every group is listed. -->
		<div class="tabs" role="tablist" aria-label="Project type" data-reveal hidden>
			{
				groups.map((g, i) => (
					<button
						type="button"
						role="tab"
						id={`project-tab-${i}`}
						aria-controls={`project-group-${i}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
					>
						{g.name} <span class="count">{g.items.length}</span>
					</button>
				))
			}
		</div>
	</div>

	<div class="groups">
		{
			groups.map((g, i) => (
				<div class="group" id={`project-group-${i}`}>
					<h3 class="group-h">{g.name}</h3>
					{/* Only the first group reveals on scroll; the others animate when their tab opens */}
					<ul role="list" class="cards" data-reveal={i === 0 ? 'stagger' : undefined}>
						{g.items.map(({ p, type }, j) => (
							<li class:list={['card', 'project', j === 0 && 'card-ink']}>
								<p class="type">{type}</p>
								<h4 class="title">{p.title}</h4>
								<p class="summary">{p.summary}</p>
								{(p.stack || p.links) && (
									<div class="foot">
										{p.stack && (
											<ul class="stack" aria-label="Built with">
												{p.stack.map((t) => (
													<li>{t}</li>
												))}
											</ul>
										)}
										{p.links && p.links.length > 0 && (
											<p class="links">
												{p.links.map((l) => (
													<a href={l.href} aria-label={`${l.label}: ${p.title}`}>
														{l.label}
													</a>
												))}
											</p>
										)}
									</div>
								)}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>

	<p class="more" data-reveal><a href={profile.github}>See all repositories on GitHub</a></p>
</section>

<style>
	.projects {
		padding-block: clamp(6rem, 12vw, 10rem) clamp(5rem, 10vw, 8rem);
	}

	ul {
		list-style: none;
		padding: 0;
	}

	/* Heading and tabs share one line */
	.head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: 1.5rem 3rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	/* Tabs: a segmented control, the chosen segment filled with ink */
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		padding: 0.3rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
	}

	.tabs[hidden] {
		display: none;
	}

	[role='tab'] {
		min-height: 2.75rem;
		padding-inline: 1rem;
		border: 0;
		border-radius: var(--radius-control);
		background: transparent;
		font: inherit;
		font-weight: 800;
		color: var(--slate);
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	[role='tab']:hover {
		color: var(--ink);
	}

	[role='tab'][aria-selected='true'] {
		background: var(--ink);
		color: var(--paper);
	}

	.count {
		font-size: 0.75em;
		font-weight: 400;
		vertical-align: super;
	}

	/* Without JS every group shows under its own heading */
	.group + .group {
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}

	.group[hidden] {
		display: none;
	}

	.group-h {
		margin-bottom: 1rem;
		font-size: var(--step-0);
		font-weight: 400;
		color: var(--slate);
	}

	/* With tabs, the tab names the group, so its heading is kept for screen readers only */
	.is-tabbed .group-h {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.is-tabbed .group + .group {
		margin-top: 0;
	}

	/* Cards: three across on wide screens, the group's first project inverted */
	.cards {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 40rem) {
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.cards {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.project {
		min-height: 17rem;
	}

	.type {
		font-size: var(--step--1);
		color: var(--slate);
	}

	.title {
		font-size: var(--step-2);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
		overflow-wrap: break-word;
		min-width: 0;
	}

	.summary {
		max-width: 40ch;
	}

	/* Stack and links settle at the bottom of the card, over a hairline */
	.foot {
		display: grid;
		gap: 0.9rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		font-size: var(--step--1);
		color: var(--slate);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		font-weight: 800;
	}

	.more {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		font-weight: 800;
	}
</style>

<script>
	import { gsap } from 'gsap';

	const root = document.querySelector<HTMLElement>('[data-projects]');
	const tablist = root?.querySelector<HTMLElement>('[role="tablist"]');
	const tabs = root ? [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')] : [];
	const groups = root ? [...root.querySelectorAll<HTMLElement>('.group')] : [];
	const still = matchMedia('(prefers-reduced-motion: reduce)');

	function selectGroup(i: number, focus = false) {
		tabs.forEach((t, j) => {
			t.setAttribute('aria-selected', String(j === i));
			t.tabIndex = j === i ? 0 : -1;
		});
		groups.forEach((g, j) => (g.hidden = j !== i));
		if (focus) tabs[i].focus();
		const cards = [...groups[i].querySelectorAll('.project')];
		if (!still.matches) {
			gsap.fromTo(cards, { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.05 });
		}
	}

	if (root && tablist && tabs.length) {
		root.classList.add('is-tabbed');
		tablist.hidden = false;
		groups.forEach((g, i) => {
			g.setAttribute('role', 'tabpanel');
			g.setAttribute('aria-labelledby', tabs[i].id);
			if (i !== 0) g.hidden = true;
		});

		tabs.forEach((t, i) => {
			t.addEventListener('click', () => selectGroup(i));
			// Arrow keys, Home and End move between tabs
			t.addEventListener('keydown', (e) => {
				const last = tabs.length - 1;
				const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
				if (next === undefined) return;
				e.preventDefault();
				selectGroup(next, true);
			});
		});
	}
</script>
