---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import { profile, about, experience, skillGroups } from '../data/portfolio';

const year = new Date().getFullYear();

const title = `${profile.name} | ${profile.role} in Jakarta`;
const description = `${profile.name} is a ${profile.role.toLowerCase()} in Jakarta building web and mobile apps with Vue, Nuxt, React, and React Native. Open to freelance work.`;

// Structured data so search engines can read who this page is about
const site = Astro.site?.href;
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': site ? `${site}#person` : '#person',
			name: profile.name,
			jobTitle: profile.role,
			description,
			...(site && { url: site, image: new URL('/og.jpg', site).href }),
			address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
			worksFor: { '@type': 'Organization', name: 'PT Reka Multi Aptika' },
			sameAs: [profile.github, profile.linkedin],
			knowsAbout: skillGroups.flatMap((g) => g.skills),
		},
		{
			'@type': 'WebSite',
			name: profile.name,
			...(site && { url: site }),
			inLanguage: 'en',
			about: { '@id': site ? `${site}#person` : '#person' },
		},
	],
};
---

<Layout title={title} description={description}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<header class="top">
		<div class="wrap top-inner">
			<a class="brand" href="#"><img src="/logo.webp" width="140" height="96" alt={profile.name} /></a>
			<nav aria-label="Main navigation">
				<a href="#about">About</a>
				<a href="#skills">Skills</a>
				<a href="#projects">Projects</a>
				<a href="#contact">Contact</a>
			</nav>
		</div>
	</header>

	<main>
		<div class="wrap">
			<Hero />
		</div>

		<!-- About: a bento, the statement as one dark card beside a column of experience cards -->
		<section class="wrap section" id="about" aria-labelledby="about-h">
			<h2 id="about-h" class="heading section-h" data-reveal="heading">About</h2>

			<div class="bento">
				<div class="card card-ink statement-card" data-reveal>
					<p class="where-from">{profile.city}</p>
					<p class="statement">{about}</p>
				</div>

				<div class="exp">
					<h3 class="exp-h" data-reveal>Experience <sup>({experience.length})</sup></h3>
					<ol class="exp-list" data-reveal="stagger">
						{
							experience.map((e) => (
								<li class="card exp-card">
									<span class="when">{e.years}</span>
									<span class="what">{e.role}</span>
									<span class="where">{e.place}</span>
								</li>
							))
						}
					</ol>
				</div>
			</div>
		</section>

		<!-- Skills: one card per group, sized by how much it holds -->
		<section class="band" id="skills" aria-labelledby="skills-h">
			<div class="wrap section">
				<h2 id="skills-h" class="heading section-h" data-reveal="heading">Skills</h2>
				<div class="skills" data-reveal="stagger">
					{
						skillGroups.map((group) => (
							<div class:list={['card', 'skill-card', group.skills.length >= 10 ? 'is-lg' : group.skills.length >= 4 && 'is-md']}>
								<h3>{group.title}</h3>
								<ul>
									{group.skills.map((s) => (
										<li>{s}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<div class="wrap">
			<Projects />
		</div>
	</main>

	<!-- Contact: inverted footer where the LinkedIn link is the headline -->
	<footer class="band contact" id="contact" aria-labelledby="contact-h">
		<div class="wrap section split">
			<h2 id="contact-h" class="heading" data-reveal="heading">Contact</h2>
			<div class="card reach" data-reveal>
				<p class="ask">{profile.status} Have a project or a role that fits?</p>
				<a class="cta" href={profile.linkedin}>Message me on LinkedIn</a>
				<p class="clock" hidden>It is <time data-clock></time> in Jakarta.</p>
			</div>
		</div>
		<div class="wrap base">
			<p>&copy; {year} {profile.name}</p>
			<p class="base-links">
				<a href={profile.github}>GitHub</a>
				<a href={profile.linkedin}>LinkedIn</a>
				<a href="#">Back to top</a>
			</p>
		</div>
	</footer>
</Layout>

<script>
	// Live Jakarta time; stays hidden if the browser can't format it
	const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
	if (clock) {
		const fmt = new Intl.DateTimeFormat('en-GB', {
			timeZone: 'Asia/Jakarta',
			hour: '2-digit',
			minute: '2-digit',
		});
		const tick = () => (clock.textContent = `${fmt.format(new Date())} WIB`);
		tick();
		clock.parentElement!.hidden = false;
		setInterval(tick, 30_000);
	}
</script>

<style>
	.wrap {
		width: min(100% - 2 * var(--gutter), var(--max));
		margin-inline: auto;
	}

	/* A plain fixed bar: the PS mark and four section links */
	.top {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		background: var(--paper);
		border-bottom: 1px solid var(--line);
	}

	.top-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem 1.5rem;
		min-height: 3.5rem;
		padding-block: 0.5rem;
	}

	.top a {
		text-decoration: none;
	}

	/* The logo file is a white mark on transparency; invert it to black on light pages */
	.brand img {
		display: block;
		width: auto;
		height: 1.5rem;
		filter: invert(1);
	}

	@media (prefers-color-scheme: dark) {
		.brand img {
			filter: none;
		}
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		font-size: var(--step--1);
	}

	nav a {
		position: relative;
		color: var(--slate);
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	nav a:hover {
		color: var(--ink);
	}

	nav a::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		bottom: -4px;
		height: 1.5px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.25s ease;
	}

	nav a:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.section {
		padding-block: clamp(5rem, 10vw, 8.5rem);
	}

	/* Section name on the left third, its content on the right two thirds */
	.split {
		display: grid;
		gap: 1.5rem 3rem;
	}

	@media (min-width: 52rem) {
		.split {
			grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
			align-items: start;
		}
	}

	.section-h {
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	/* About: the statement card takes two thirds, the experience column the rest */
	.bento {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 52rem) {
		.bento {
			grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		}
	}

	.statement-card {
		justify-content: space-between;
		gap: 3rem;
		min-height: 22rem;
		padding: clamp(1.75rem, 4vw, 3.5rem);
	}

	.where-from {
		color: var(--slate);
	}

	.statement {
		max-width: 22ch;
		font-size: clamp(1.75rem, 1rem + 2.4vw, 3rem);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: -0.03em;
		text-wrap: pretty;
	}

	.exp {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.exp-h {
		font-size: var(--step-0);
		font-weight: 400;
		color: var(--slate);
	}

	.exp-h sup {
		font-size: 0.75em;
	}

	.exp-list {
		flex: 1;
		display: grid;
		gap: 1rem;
		list-style: none;
		padding: 0;
	}

	.exp-card {
		gap: 0.35rem;
		justify-content: end;
	}

	.what {
		font-size: var(--step-1);
		font-weight: 800;
		line-height: 1.25;
	}

	.where,
	.when {
		color: var(--slate);
	}

	.when {
		font-size: var(--step--1);
		font-variant-numeric: tabular-nums;
	}

	/* Inverted bands (skills and footer) take the band tokens */
	.band {
		--paper: var(--band-paper);
		--ink: var(--band-ink);
		--slate: var(--band-slate);
		--line: var(--band-line);
		--surface: var(--band-surface);
		background: var(--paper);
		color: var(--ink);
	}

	/* Skills: a packed grid; the biggest group takes a 2 by 2 card, mid-sized groups a wide one */
	.skills {
		display: grid;
		grid-auto-flow: dense;
		gap: 1rem;
	}

	@media (min-width: 40rem) {
		.skills {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.skill-card.is-lg {
			grid-column: span 2;
		}
	}

	@media (min-width: 64rem) {
		.skills {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.skill-card.is-lg {
			grid-row: span 2;
		}

		.skill-card.is-md {
			grid-column: span 2;
		}
	}

	.skill-card {
		gap: 1.25rem;
	}

	.skill-card h3 {
		font-size: var(--step-1);
		font-weight: 800;
	}

	.skill-card ul {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.skill-card li {
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-control);
		font-size: var(--step--1);
	}

	/* The 2 by 2 card sets its skills a step larger, so it reads as the lead group */
	@media (min-width: 64rem) {
		.skill-card.is-lg {
			justify-content: space-between;
		}

		.skill-card.is-lg h3 {
			font-size: var(--step-2);
		}

		.skill-card.is-lg li {
			font-size: var(--step-0);
			padding: 0.4rem 0.85rem;
		}
	}

	/* Contact */
	.reach {
		container-type: inline-size;
		gap: 1.25rem;
		align-items: start;
		padding: clamp(1.75rem, 4vw, 3rem);
	}

	.ask {
		max-width: 40ch;
		font-size: var(--step-1);
		color: var(--slate);
	}

	/* Sized from its column so the one line never wraps, 320px included */
	.cta {
		font-size: min(3.5rem, 100cqi / 13.5);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
		white-space: nowrap;
		text-decoration-thickness: 0.06em;
		text-underline-offset: 0.15em;
	}

	.cta:hover {
		text-underline-offset: 0.25em;
	}

	.clock {
		color: var(--slate);
		font-variant-numeric: tabular-nums;
	}

	.base {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding-block: 1.5rem 2rem;
		border-top: 1px solid var(--line);
		font-size: var(--step--1);
		color: var(--slate);
	}

	.base-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}

	.base a {
		color: var(--ink);
	}
</style>
