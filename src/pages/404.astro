---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/portfolio';
---

<Layout title={`Page not found | ${profile.name}`} description="This page doesn’t exist." noindex>
	<main class="missing">
		<h1>This page doesn’t exist</h1>
		<p>The link may be old or mistyped.</p>
		<a class="back" href="/">Go to the homepage</a>
	</main>
</Layout>

<style>
	.missing {
		width: min(100% - 2 * var(--gutter), var(--max));
		min-height: 100svh;
		margin-inline: auto;
		display: grid;
		align-content: center;
		justify-items: start;
		gap: 1rem;
	}

	h1 {
		font-size: var(--step-section);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	p {
		color: var(--slate);
	}

	.back {
		display: inline-flex;
		align-items: center;
		min-height: 3rem;
		margin-top: 0.5rem;
		padding-inline: 1.25rem;
		border: 2px solid var(--ink);
		border-radius: var(--radius-control);
		background: var(--ink);
		color: var(--paper);
		text-decoration: none;
		font-weight: 800;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.back:hover {
		background: transparent;
		color: var(--ink);
	}

	@media (prefers-reduced-motion: reduce) {
		.back {
			transition: none;
		}
	}

	.back:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.back:active {
		opacity: 0.7;
	}
</style>
