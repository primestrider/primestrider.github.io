---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/portfolio';
---

<Layout title={`Page not found | ${profile.name}`} description="This page doesn’t exist." noindex>
	<main class="missing">
		<h1>This page doesn’t exist</h1>
		<p>The link may be old or mistyped.</p>
		<a class="back" href="/">Go to the homepage</a>
	</main>
</Layout>

<style>
	.missing {
		width: min(100% - 2 * var(--gutter), var(--max));
		min-height: 100svh;
		margin-inline: auto;
		display: grid;
		align-content: center;
		justify-items: start;
		gap: 1rem;
	}

	h1 {
		font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.05em;
	}

	p {
		color: var(--slate);
	}

	.back {
		margin-top: 0.5rem;
		padding: 0.7rem 1.1rem;
		background: var(--ink);
		color: var(--paper);
		text-decoration: none;
		font-weight: 600;
		border-radius: 999px;
	}

	.back:hover {
		background: var(--slate);
		color: var(--paper);
	}
</style>
